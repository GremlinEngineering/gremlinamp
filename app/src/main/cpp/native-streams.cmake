# The pinned web build lists the small SIDLITE-backed engine and generated drivers.
set(SID_ROOT "${BROAD}/libsidplayfp/src")
set(SID_GENERATED "${CMAKE_CURRENT_BINARY_DIR}/sidplayfp")
set(SID_LITE "builders/sidlite-builder")
set(SID_DRIVERS "${VGMPLAY2}/cmake/libsidplayfp-generated")
set(LIB_MAJOR 3)
set(LIB_MINOR 0)
set(LIB_LEVEL 2)
set(HAVE_BUILTIN_EXPECT 1)
configure_file("${SID_ROOT}/sidplayfp/sidversion.h.in" "${SID_GENERATED}/sidplayfp/sidversion.h" @ONLY)
configure_file("${SID_ROOT}/${SID_LITE}/sidlite/sl_defs.h.in" "${SID_GENERATED}/sl_defs.h" @ONLY)
configure_file("${SID_DRIVERS}/psiddrv.bin" "${SID_GENERATED}/psiddrv.bin" COPYONLY)
foreach(file sidplayer1.bin sidplayer2.bin)
    configure_file("${SID_DRIVERS}/sidtune/${file}" "${SID_GENERATED}/${file}" COPYONLY)
endforeach()
file(READ "${VGMPLAY2}/CMakeLists.txt" BROAD_CMAKE)
string(REGEX MATCHALL "modules/libsidplayfp/src/[A-Za-z0-9_./-]+[.]cpp" SID_FILES "${BROAD_CMAKE}")
list(REMOVE_DUPLICATES SID_FILES)
list(TRANSFORM SID_FILES REPLACE "^modules/libsidplayfp/src/" "${SID_ROOT}/")
add_library(gremlinamp-sid-core STATIC ${SID_FILES})
target_include_directories(gremlinamp-sid-core PRIVATE "${SID_ROOT}" "${SID_ROOT}/${SID_LITE}"
    "${SID_ROOT}/${SID_LITE}/sidlite" "${SID_GENERATED}")
target_compile_definitions(gremlinamp-sid-core PRIVATE PACKAGE="libsidplayfp" PACKAGE_NAME="libsidplayfp"
    PACKAGE_VERSION="3.0.2" PACKAGE_URL="https://github.com/libsidplayfp/libsidplayfp" VERSION="3.0.2" HAVE_CXX11=1)

function(add_xa)
    # CD-XA is implemented in vgmstream itself.
    foreach(option USE_MPEG USE_VORBIS USE_FFMPEG USE_G7221 USE_G719 USE_ATRAC9 USE_CELT USE_SPEEX)
        set(${option} OFF CACHE BOOL "" FORCE)
    endforeach()
    set(BUILD_CLI OFF CACHE BOOL "" FORCE)
    set(BUILD_V123 OFF CACHE BOOL "" FORCE)
    set(BUILD_AUDACIOUS OFF CACHE BOOL "" FORCE)
    set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
    add_subdirectory("${BROAD}/vgmstream" vgmstream EXCLUDE_FROM_ALL)
endfunction()
add_xa()
add_library(gremlinamp-streams SHARED streams_bridge.cpp)
target_include_directories(gremlinamp-streams PRIVATE "${SID_ROOT}" "${SID_GENERATED}" "${BROAD}/vgmstream/src")
target_link_libraries(gremlinamp-streams PRIVATE gremlinamp-sid-core libvgmstream m)
target_link_options(gremlinamp-streams PRIVATE "-Wl,-z,max-page-size=16384")
