# The native targets use the source snapshots and options of the site builds.
function(add_board name root)
    set(sources ${ARGN})
    list(TRANSFORM sources PREPEND "${root}/")
    add_library(gremlinamp-${name} SHARED ${sources})
    target_include_directories(gremlinamp-${name} PRIVATE "${root}" "${root}/hash")
    target_compile_features(gremlinamp-${name} PRIVATE cxx_std_20)
    target_compile_options(gremlinamp-${name} PRIVATE -fwrapv -ffp-contract=off)
    target_compile_definitions(gremlinamp-${name} PRIVATE INLINE=inline)
    target_link_options(gremlinamp-${name} PRIVATE "-Wl,-z,max-page-size=16384")
    target_link_libraries(gremlinamp-${name} PRIVATE m)
endfunction()

