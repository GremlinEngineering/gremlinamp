extract_decoder(MODEL2_M2S_0_15_SOURCE.zip m2s M2S)
function(add_model2)
    set(SSFPLAY_BUILD_SHARED ON)
    set(SSFPLAY_BUILD_CLI OFF)
    set(SSFPLAY_BUILD_PLAYER OFF)
    set(SSFPLAY_BUILD_LIBVGM_AB_PLAYER OFF)
    set(BUILD_TESTING OFF)
    set(mednafen "${M2S}/sas-source/mednafen")
    if(NOT EXISTS "${mednafen}/include/mednafen/types.h")
        file(MAKE_DIRECTORY "${mednafen}/include")
        file(CREATE_LINK "${mednafen}/src" "${mednafen}/include/mednafen" SYMBOLIC COPY_ON_ERROR)
    endif()
    # API 26 supplies zlib. The player uses titles from the manifest and can
    # use the archive's existing no-iconv path for embedded tags.
    set(build_file "${M2S}/sas-source/CMakeLists.txt")
    file(READ "${build_file}" build)
    if(build MATCHES "find_package\\(Iconv REQUIRED\\)")
        string(REPLACE "find_package(Iconv REQUIRED)" "find_package(Iconv QUIET)" build "${build}")
        string(REPLACE "set(HAVE_ICONV 1)" "set(HAVE_ICONV \${Iconv_FOUND})" build "${build}")
        file(WRITE "${build_file}" "${build}")
    endif()
    add_subdirectory("${M2S}/sas-source" model2)
endfunction()
add_model2()
set_target_properties(ssfplay PROPERTIES OUTPUT_NAME gremlinamp-m2s)
target_compile_options(ssfplay PRIVATE -ffp-contract=off)
target_link_options(ssfplay PRIVATE "-Wl,-z,max-page-size=16384")

