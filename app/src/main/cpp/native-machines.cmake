set(GBA_ROOT "${GBA_SOURCE}/mgba-1c61b54208ca6266129d0f2394c04bd8c44f98c5")
if(NOT EXISTS "${GBA_ROOT}/CMakeLists.txt")
    file(ARCHIVE_EXTRACT INPUT "${GBA_SOURCE}/upstream-source.zip" DESTINATION "${GBA_SOURCE}")
endif()
function(add_gba)
    file(READ "${GBA_SOURCE}/build-options.json" options)
    string(JSON count LENGTH "${options}")
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON option MEMBER "${options}" ${i})
        if(NOT option STREQUAL "CMAKE_BUILD_TYPE")
            string(JSON value GET "${options}" "${option}")
            set(${option} "${value}")
        endif()
    endforeach()
    add_subdirectory("${GBA_ROOT}" gba-core EXCLUDE_FROM_ALL)
endfunction()
add_gba()
