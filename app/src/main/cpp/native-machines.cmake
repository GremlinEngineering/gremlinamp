find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(MACHINE_BUILDER "${REPO_ROOT}/tools/build-native-machine.py")
set(WS_HEADROOM_PATCH "${REPO_ROOT}/decoder-sources/ws-headroom/headroom.patch")

function(add_machine name archive)
    extract_decoder("${archive}" "${name}" source)
    set(output "${CMAKE_CURRENT_BINARY_DIR}/machine-libs/libgremlinamp-${name}.so")
    add_custom_command(OUTPUT "${output}"
        COMMAND "${Python3_EXECUTABLE}" "${MACHINE_BUILDER}"
            --name "${name}" --source "${source}" --output "${output}"
            --cc "${CMAKE_C_COMPILER}" --cxx "${CMAKE_CXX_COMPILER}" --ar "${CMAKE_AR}"
            --target "${CMAKE_C_COMPILER_TARGET}" --headroom-patch "${WS_HEADROOM_PATCH}"
        DEPENDS "${MACHINE_BUILDER}" "${REPO_ROOT}/decoder-sources/archives/${archive}" "${WS_HEADROOM_PATCH}"
        VERBATIM)
    add_custom_target(build-machine-${name} DEPENDS "${output}")
    add_library(gremlinamp-${name} SHARED IMPORTED)
    set_target_properties(gremlinamp-${name} PROPERTIES IMPORTED_LOCATION "${output}")
    add_dependencies(gremlinamp-${name} build-machine-${name})
    target_link_libraries(gremlinamp PRIVATE gremlinamp-${name})
endfunction()

